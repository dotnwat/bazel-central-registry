# =============================================================================
# src/aapl: Header-only library for data structures (AVL trees, lists, etc.)
# Headers are included as bare names: #include <avltree.h>
# =============================================================================
cc_library(
    name = "aapl",
    hdrs = glob(["src/aapl/*.h"]),
    includes = ["src/aapl"],
    visibility = ["//visibility:public"],
)

