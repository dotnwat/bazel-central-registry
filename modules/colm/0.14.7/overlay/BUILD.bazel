# loadfinal.cc is textually #included by loadcolm.cc and loadboot2.cc
# (not compiled directly).
cc_library(
    name = "loadfinal_inc",
    textual_hdrs = ["src/loadfinal.cc"],
    hdrs = ["src/loadfinal.h"],
    deps = [
        ":aapl",
        ":colm_hdrs",
        ":libprog",
    ],
)

# =============================================================================
# Bootstrap chain: bootstrap0 -> bootstrap1 -> bootstrap2 -> colm
#
# Each stage generates parser sources for the next stage.
# bootstrap0 uses internal constructors (no grammar file).
# bootstrap1 parses a stripped-down colm syntax.
# bootstrap2 parses the full colm grammar.
# The final colm binary is built with the output of bootstrap2.
# =============================================================================

# --- Stage 0: bootstrap0 binary ---
cc_binary(
    name = "bootstrap0",
    srcs = [
        "src/consinit.cc",
        "src/consinit.h",
        "src/main.cc",
    ] + _PROG_HDRS,
    copts = _PROG_COPTS + ["-DCONS_INIT"],
    deps = _PROG_DEPS + [
        ":libcolm",
        ":libprog",
    ],
)

# --- Stage 0 -> 1: generate if1.h, if1.cc, parse1.c ---
genrule(
    name = "gen_bootstrap1",
    srcs = [],
    outs = [
        "src/gen/if1.h",
        "src/gen/if1.cc",
        "src/gen/parse1.c",
    ],
    cmd = "$(execpath :bootstrap0) -c" +
          " -e $(execpath src/gen/if1.h)" +
          " -x $(execpath src/gen/if1.cc)" +
          " -p $(execpath src/gen/parse1.c)" +
          " no-input",
    tools = [":bootstrap0"],
)

# --- Stage 1: bootstrap1 binary ---
cc_binary(
    name = "bootstrap1",
    srcs = [
        "src/loadinit.cc",
        "src/loadinit.h",
        "src/main.cc",
        "src/gen/if1.h",
        "src/gen/if1.cc",
        "src/gen/parse1.c",
    ] + _PROG_HDRS,
    copts = _PROG_COPTS + ["-DLOAD_INIT"],
    deps = _PROG_DEPS + [
        ":libcolm",
        ":libprog",
    ],
)

# --- Stage 1 -> 2: generate if2.h, if2.cc, parse2.c ---
genrule(
    name = "gen_bootstrap2",
    srcs = ["src/colm.lm"],
    outs = [
        "src/gen/if2.h",
        "src/gen/if2.cc",
        "src/gen/parse2.c",
    ],
    cmd = "$(execpath :bootstrap1) -c" +
          " -e $(execpath src/gen/if2.h)" +
          " -x $(execpath src/gen/if2.cc)" +
          " -p $(execpath src/gen/parse2.c)" +
          " $(execpath src/colm.lm)",
    tools = [":bootstrap1"],
)

# --- Stage 2: bootstrap2 binary ---
cc_binary(
    name = "bootstrap2",
    srcs = [
        "src/loadboot2.cc",
        "src/main.cc",
        "src/gen/if2.h",
        "src/gen/if2.cc",
        "src/gen/parse2.c",
    ] + _PROG_HDRS,
    copts = _PROG_COPTS + ["-DLOAD_COLM"],
    deps = _PROG_DEPS + [
        ":libcolm",
        ":libprog",
        ":loadfinal_inc",
    ],
)

# --- Stage 2 -> 3: generate if3.h, if3.cc, parse3.c ---
genrule(
    name = "gen_colm",
    srcs = [
        "src/prog.lm",
        "src/colm.lm",
    ],
    outs = [
        "src/gen/if3.h",
        "src/gen/if3.cc",
        "src/gen/parse3.c",
    ],
    # prog.lm does `include 'colm.lm'` which is resolved relative to cwd.
    # Use -I to point at the directory containing colm.lm.
    cmd = "$(execpath :bootstrap2) -c" +
          " -I $$(dirname $(execpath src/colm.lm))" +
          " -e $(execpath src/gen/if3.h)" +
          " -x $(execpath src/gen/if3.cc)" +
          " -p $(execpath src/gen/parse3.c)" +
          " $(execpath src/prog.lm)",
    tools = [":bootstrap2"],
)

# --- Final: colm compiler binary ---
cc_binary(
    name = "colm",
    srcs = [
        "src/main.cc",
        "src/loadcolm.cc",
        "src/gen/if3.h",
        "src/gen/if3.cc",
        "src/gen/parse3.c",
    ],
    copts = _PROG_COPTS + ["-DLOAD_COLM"],
    visibility = ["//visibility:public"],
    deps = _PROG_DEPS + [
        ":libcolm",
        ":libprog",
        ":loadfinal_inc",
    ],
)
